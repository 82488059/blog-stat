# Copy to .env (never commit). Or set in the process / Task Scheduler / nginx unit.

# SQLite directory (default: ./data)
# STAT_DATA_DIR=E:\repos\blog-stat\data

# Comma-separated CORS origins (default: known blog domains only; never use *)
# STAT_CORS_ORIGINS=https://www.xssl.online,https://xssl.online,https://82488059.github.io

# Debounce same IP+path hits (seconds). 0 = count every refresh
# STAT_DEBOUNCE_SECONDS=0

# Enable GET /api/stat/pages when set. Use a long random string.
# STAT_PAGES_TOKEN=replace-with-a-long-random-secret

# POST rate limit per IP (window seconds / max hits). 0 disables.
# STAT_RATE_LIMIT_WINDOW=60
# STAT_RATE_LIMIT_MAX=120

# Max POST body size in bytes
# STAT_MAX_BODY_BYTES=4096
